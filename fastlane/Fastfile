# Base Converter release automation.
#
# Requires an App Store Connect API key. See fastlane/README.md for how to
# create one and which environment variables to set. Nothing secret belongs
# in this file or anywhere else in the repo.

default_platform(:ios)
opt_out_usage

PROJECT     = "BaseConverterApp.xcodeproj"
SCHEME      = "BaseConverterApp"
TEST_DEVICE = "iPhone 17 Pro"

# Export compliance. This MUST stay in agreement with
# INFOPLIST_KEY_ITSAppUsesNonExemptEncryption in the pbxproj. If the two ever
# disagree, App Store Connect rejects the submission. The app ships no custom
# cryptography and makes no network calls, so it is exempt.
USES_NON_EXEMPT_ENCRYPTION = false

platform :ios do
  desc "Run the full test suite on a simulator"
  lane :test do
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      devices: [TEST_DEVICE]
    )
  end

  desc "Build and upload a build to TestFlight"
  lane :beta do
    key = asc_api_key
    bump_build_number(key)
    build_release_ipa
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build, upload, and submit to App Review. Does NOT auto-release on approval."
  lane :release do
    key = asc_api_key
    bump_build_number(key)
    build_release_ipa
    upload_to_app_store(
      api_key: key,
      submit_for_review: true,
      automatic_release: false,
      force: true,                 # skip the interactive HTML preview
      skip_metadata: true,         # the App Store listing is maintained by hand
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: USES_NON_EXEMPT_ENCRYPTION,
        add_id_info_uses_idfa: false
      }
    )
  end
end

# Fails loudly and early if credentials are missing, rather than surfacing a
# confusing authentication error partway through an upload.
def asc_api_key
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].reject { |v| ENV[v].to_s.strip != "" }
  unless missing.empty?
    UI.user_error!("Missing environment variable(s): #{missing.join(', ')}. See fastlane/SETUP.md.")
  end

  key_path = File.expand_path(ENV["ASC_KEY_PATH"])
  UI.user_error!("ASC_KEY_PATH does not exist: #{key_path}") unless File.exist?(key_path)

  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: key_path
  )
end

# Sets the build number to one above the highest already on App Store Connect,
# so local build numbers can never collide with what Apple has seen.
def bump_build_number(key)
  latest = latest_testflight_build_number(
    api_key: key,
    initial_build_number: 0
  )
  increment_build_number(
    xcodeproj: PROJECT,
    build_number: latest + 1
  )
end

def build_release_ipa
  build_app(
    project: PROJECT,
    scheme: SCHEME,
    export_method: "app-store"
  )
end
